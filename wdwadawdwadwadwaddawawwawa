local function firePrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then
        return false
    end

    local fired = false

    -- Prefer the executor prompt primitive when available.
    if type(fireproximityprompt) == "function" then
        local ok = pcall(function()
            fireproximityprompt(prompt)
        end)
        if ok then
            fired = true
        end
    end

    -- Fallback for executors that do not expose fireproximityprompt.
    if not fired then
        local ok = pcall(function()
            prompt:InputHoldBegin()
            if prompt.HoldDuration > 0 then
                task.wait(prompt.HoldDuration + 0.08)
            else
                task.wait(0.08)
            end
            prompt:InputHoldEnd()
        end)
        fired = ok
    end

    -- Give the game a moment to process the prompt.
    if fired then
        task.wait(0.12)
    end

    return fired
end

local function getPromptPosition(prompt)
    if not prompt or not prompt.Parent then
        return nil
    end

    local parent = prompt.Parent
    if parent:IsA("Attachment") then
        return parent.WorldPosition
    end

    if parent:IsA("BasePart") then
        return parent.Position
    end

    local model = prompt:FindFirstAncestorOfClass("Model")
    if model then
        return model:GetPivot().Position
    end

    return nil
end

local function findEnabledPrompt(container, actionText)
    if not container then return nil end

    local exact
    local partial

    for _, descendant in ipairs(container:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant.Enabled then
            if promptMatches(descendant, actionText) then
                return descendant
            end

            local actual = normalizePromptText(descendant.ActionText)
            local wanted = normalizePromptText(actionText)
            if actual:find(wanted, 1, true) or wanted:find(actual, 1, true) then
                partial = partial or descendant
            end

            exact = exact or descendant
        end
    end

    return partial
end

