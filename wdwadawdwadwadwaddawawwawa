local function countNumz()
    local count = 0
    local best
    local bestPay = 0
    for _, name in ipairs(NUMZ_PRODUCTS) do
        if hasTool(name) then
            count = count + 1
            local payout = FLAVOR_PAYOUT[name] or 0
            if payout >= bestPay then
                best = name
                bestPay = payout
            end
        end
    end
    return count, best, bestPay
end

-- Snapshot current inventory state
local function snapshotInventory()
    local snap = {}
    for _, name in ipairs(NUMZ_PRODUCTS) do
        snap[name] = hasTool(name) and 1 or 0
    end
    return snap
end

-- Diff snapshot against previous; accumulate new arrivals
local function tickInventory()
    local current = snapshotInventory()
    for _, name in ipairs(NUMZ_PRODUCTS) do
        local prev = previousInventory[name] or 0
        local curr = current[name] or 0
        if curr > prev then
            local gained = curr - prev
            sessionCounts[name] = sessionCounts[name] + gained
            sessionEarnings = sessionEarnings + gained * (FLAVOR_PAYOUT[name] or 0)
        end
    end
    previousInventory = current
end

local function resetSessionCounts()
    for _, name in ipairs(NUMZ_PRODUCTS) do
        sessionCounts[name] = 0
    end
    sessionEarnings = 0
    previousInventory = snapshotInventory()
end

local function velocityTeleport(targetCF, awaitArrival)
    local root = getRoot()
    if not root then return false end

    enableNoclip()

    local target = targetCF.Position + Vector3.new(0, 3, 0)
    local done = false
    local success = false
    local connection

    local function cleanup()
        if connection then
            connection:Disconnect()
            connection = nil
        end
        disableNoclip()
    end

    connection = RunService.Heartbeat:Connect(function()
        if not automationActive() and not awaitArrival then
            cleanup()
            resetCharacter()
            done = true
            return
        end

        root = getRoot()
        if not root or not root.Parent then
            cleanup()
            done = true
            return
        end

        local direction = target - root.Position
        local distance = direction.Magnitude

        if distance <= STOP_DISTANCE then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(target)
            cleanup()
            resetCharacter()
            success = true
            done = true
            return
        end

        root.AssemblyLinearVelocity = direction.Unit * MOVE_SPEED
    end)

    if awaitArrival then
        local deadline = os.clock() + 15
        while not done and os.clock() < deadline do
            task.wait(0.05)
        end

        if not done then
            cleanup()
            local currentRoot = getRoot()
            if currentRoot then
                currentRoot.AssemblyLinearVelocity = Vector3.zero
                currentRoot.AssemblyAngularVelocity = Vector3.zero
            end
        end

        return success
    end

    return true
end

