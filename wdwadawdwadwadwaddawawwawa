local function buyPrepItems()
    if not goToPablos() then return false end
    task.wait(0.5)

    local wanted = {}
    for i, item in ipairs(PABLO_ITEMS) do
        if not hasTool(item) then
            table.insert(wanted, item)
            if not buyPablo(item) then return false end
            if not waitForTool(item, 12) then return false end
            if i < #PABLO_ITEMS and not hasAllPrep() then
                task.wait(BUY_COOLDOWN)
            end
        end
    end
    return #wanted == 0 or hasAllPrep()
end

