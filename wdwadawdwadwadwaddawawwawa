local function iterCookers()
    local area = getCookingArea()
    if not area then return {} end

    local list = {}
    for _, child in ipairs(area:GetChildren()) do
        if child.Name == "GasCooker" then
            table.insert(list, child)
        end
    end
    if #list == 0 then
        for _, descendant in ipairs(area:GetDescendants()) do
            if descendant.Name == "GasCooker" then
                table.insert(list, descendant)
            end
        end
    end
    return list
end

waitForCookers = function(timeout)
    timeout = timeout or 15
    local started = os.clock()
    while os.clock() - started < timeout do
        if not automationActive() then return false end
        if #iterCookers() > 0 then return true end
        task.wait(0.3)
    end
    return false
end

local function isCookerUnclaimed(cooker)
    if getCookerOwner(cooker) then return false end
    if getCookerStage(cooker) == 0 then return true end
    local claim = getCookerPrompt(cooker, COOK_ACTIONS.CLAIM)
    return claim ~= nil and claim.Enabled
end

local function waitForPrompt(cooker, actionText, timeout)
    timeout = timeout or 8
    local started = os.clock()

    while os.clock() - started < timeout do
        if not automationActive() then
            return nil
        end

        local prompt = getCookerPrompt(cooker, actionText)
        if prompt then
            return prompt
        end

        task.wait(0.15)
    end

    return nil
end

local function findUnclaimedCooker()
    local root = getRoot()
    local best
    local bestScore = -math.huge

    for _, cooker in ipairs(iterCookers()) do
        if isCookerUnclaimed(cooker) then
            local distance = root
                and (root.Position - cooker:GetPivot().Position).Magnitude
                or 9999
            local flavor = getCookerFlavor(cooker)
            local score = (FLAVOR_PAYOUT[flavor] or 0) * 1000 - distance
            if score > bestScore then
                best = cooker
                bestScore = score
            end
        end
    end
    return best, best and getCookerFlavor(best) or nil
end

local function cookerNeedsWork(cooker)
    if not cooker or not cooker.Parent then return false end
    local stage = getCookerStage(cooker)
    if stage < 4 then return true end
    local cut = getCookerPrompt(cooker, COOK_ACTIONS.CUT)
    return cut ~= nil and cut.Enabled and countNumz() == 0
end

local function findMyCooker()
    local best
    local bestStage
    for _, cooker in ipairs(iterCookers()) do
        if getCookerOwner(cooker) == LP.Name and cookerNeedsWork(cooker) then
            local stage = getCookerStage(cooker)
            if not bestStage or stage > bestStage then
                best = cooker
                bestStage = stage
            end
        end
    end
    return best
end

local function needsPrepBuy(mine)
    if hasAllPrep() then return false end
    if mine and not cookerNeedsWork(mine) then mine = nil end
    if not mine then
        return not hasTool("Water Gallon") or not hasTool("Flavor Packet")
    end

    local stage = getCookerStage(mine)
    if stage >= 3 then return false end
    if stage <= 1 then
        return not hasTool("Water Gallon") or not hasTool("Flavor Packet")
    end
    return not hasTool("Flavor Packet")
end

local function waitForStage(cooker, targetStage, timeout)
    timeout = timeout or 90
    local started = os.clock()
    while os.clock() - started < timeout do
        if not automationActive() then return false end
        if not cooker.Parent then return false end
        if getCookerStage(cooker) >= targetStage then return true end
        task.wait(0.25)
    end
    return false
end

local function hideWaitForStage(cooker, targetStage, timeout)
    timeout = timeout or 120
    local base = cooker:GetPivot().Position
    local hideCF = CFrame.new(base.X, base.Y - 12, base.Z)

    enableNoclip()
    local root = getRoot()
    if root then
        root.CFrame = hideCF
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = true
    end

    local reached = false
    local started = os.clock()
    while os.clock() - started < timeout do
        if not automationActive() then break end
        if not cooker.Parent then break end
        if getCookerStage(cooker) >= targetStage then
            reached = true
            break
        end

        root = getRoot()
        if root and (root.Position - hideCF.Position).Magnitude > 2 then
            root.Anchored = false
            root.CFrame = hideCF
            root.AssemblyLinearVelocity = Vector3.zero
            root.Anchored = true
        end
        task.wait(0.25)
    end

    root = getRoot()
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    disableNoclip()
    return reached or getCookerStage(cooker) >= targetStage
end

local function useCookerPrompt(cooker, actionText, waitAfter, promptTimeout)
    promptTimeout = promptTimeout or 8
    waitAfter = waitAfter or 0

    for attempt = 1, 4 do
        if not automationActive() then
            return false
        end

        local prompt = waitForPrompt(cooker, actionText, promptTimeout)
        if not prompt then
            task.wait(0.25)
        else

        -- Move close to the actual prompt rather than assuming the cooker pivot
        -- is the interaction point.
        local promptPos = getPromptPosition(prompt)
        local targetPos = promptPos or cooker:GetPivot().Position

        if not goToTarget(targetPos, Vector3.new(0, 0, 3)) then
            task.wait(0.25)
            continue
        end

        task.wait(0.15)

        -- Reacquire it after movement because prompts can be recreated.
        prompt = getCookerPrompt(cooker, actionText) or findEnabledPrompt(cooker, actionText)
        if prompt and prompt.Enabled and firePrompt(prompt) then
            if waitAfter > 0 then
                task.wait(waitAfter)
            end
            return true
        end

        task.wait(0.35)
        end
    end

    return false
end

local function cookOnce()
    if not goToCookingArea() then return false end

    local cooker = findMyCooker()
    local flavor
    if cooker then
        flavor = getCookerFlavor(cooker)
    else
        if not hasAllPrep() then return false end
        cooker, flavor = findUnclaimedCooker()
    end
    if not cooker then return false end

    if not getCookerOwner(cooker) then
        if not useCookerPrompt(cooker, COOK_ACTIONS.CLAIM, 0.8) then return false end
        local started = os.clock()
        while os.clock() - started < 8 do
            if getCookerOwner(cooker) == LP.Name then break end
            task.wait(0.2)
        end
        if getCookerOwner(cooker) ~= LP.Name then return false end
    end

    local stage = getCookerStage(cooker)
    if stage <= 2 and not hasPrepForStage(stage) then return false end

    if getCookerStage(cooker) <= 1 then
        equipTool("Water Gallon")
        if not useCookerPrompt(cooker, COOK_ACTIONS.WATER, 0.1) then return false end
        if not waitForStage(cooker, 2, 30) then
            equipTool("Water Gallon")
            useCookerPrompt(cooker, COOK_ACTIONS.WATER, 0.1)
            if not waitForStage(cooker, 2, 20) then return false end
        end
    end

    if getCookerStage(cooker) <= 2 then
        equipTool("Flavor Packet")
        if not useCookerPrompt(cooker, COOK_ACTIONS.FLAVOR, 0.1) then return false end
        if not waitForStage(cooker, 3, 20) then
            equipTool("Flavor Packet")
            useCookerPrompt(cooker, COOK_ACTIONS.FLAVOR, 0.1)
            if not waitForStage(cooker, 3, 15) then return false end
        end
    end

    if getCookerStage(cooker) <= 3 then
        local humanoid = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function()
                humanoid:UnequipTools()
            end)
        end
        task.wait(0.15)
        if not useCookerPrompt(cooker, COOK_ACTIONS.BOIL, 0.1, 30) then return false end
        if not hideWaitForStage(cooker, 4, 120) then
            useCookerPrompt(cooker, COOK_ACTIONS.BOIL, 0.1, 15)
            if not hideWaitForStage(cooker, 4, 60) then return false end
        end
    end

    local before = countNumz()
    local started = os.clock()
    while os.clock() - started < 30 do
        if countNumz() > before then break end
        useCookerPrompt(cooker, COOK_ACTIONS.CUT, 0.4)
        local waitStarted = os.clock()
        while os.clock() - waitStarted < 4 do
            if countNumz() > before then break end
            task.wait(0.3)
        end
    end

    started = os.clock()
    while os.clock() - started < 6 do
        if countNumz() > before then
            tickInventory()
            return true
        end
        task.wait(0.3)
    end
    return false
end

local function trackBuyer()
    if not NumzFunction then return nil end
    local ok, data = pcall(function()
        return NumzFunction:InvokeServer("TrackBuyer")
    end)
    if not ok or not data then return nil end
    if typeof(data) == "table" and data.Buyer and data.Buyer.Parent then
        activeBuyer = data.Buyer
        return data
    end
    return nil
end

local function getBuyerPrompt(buyer)
    if not buyer or not buyer.Parent then
        return nil
    end

    local best

    for _, descendant in ipairs(buyer:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant.Enabled then
            best = descendant
            if normalizePromptText(descendant.ActionText):find("sell", 1, true) then
                return descendant
            end
        end
    end

    return best
end

local function sellToBuyer(buyer, product)
    if not buyer or not buyer.Parent then
        return false
    end

    if product then
        equipTool(product)
    end

    local prompt = getBuyerPrompt(buyer)
    local targetPos = prompt and getPromptPosition(prompt) or nil

    if targetPos then
        if not goToTarget(targetPos, Vector3.new(0, 0, 3)) then
            return false
        end
    elseif not goToTarget(buyer, Vector3.new(0, 0, -5)) then
        return false
    end

    task.wait(0.15)

    if product then
        equipTool(product)
    end

    prompt = getBuyerPrompt(buyer)
    if not prompt then
        task.wait(0.3)
        prompt = getBuyerPrompt(buyer)
    end

    return prompt ~= nil and firePrompt(prompt) or false
end

local function sellNumz()
    local before, product = countNumz()
    if before == 0 then return false end
    equipTool(product)

    local data = trackBuyer()
    if not data then return false end
    local buyer = data.Buyer
    local deadline = (data.TimeStarted or tick()) + 175

    while automationActive() and buyer and buyer.Parent and tick() < deadline do
        if countNumz() < before then
            activeBuyer = nil
            tickInventory()
            return true
        end

        local root = getRoot()
        local hrp = buyer:FindFirstChild("HumanoidRootPart")
        if root and hrp then
            if (root.Position - hrp.Position).Magnitude > 8 then
                goToTarget(buyer, Vector3.new(0, 0, -5))
            else
                sellToBuyer(buyer, product)
                task.wait(0.6)
            end
        end
        task.wait(0.25)
    end
    return countNumz() < before
end

local function runOnce()
    local numzCount, product = countNumz()
    if numzCount == 0 then
        local mine
        if hasAllPrep() or hasTool("Water Gallon") or hasTool("Flavor Packet") then
            if not goToCookingArea() then return false end
            mine = findMyCooker()
        end
        if needsPrepBuy(mine) and not buyPrepItems() then return false end
        if not cookOnce() then return false end
        numzCount, product = countNumz()
        if numzCount == 0 then return false end
    end
    return sellNumz()
end

local function autoLoop()
    if running or cycleRunning then return false end
    running = true
    task.spawn(function()
        while running do
            if runOnce() then
                task.wait(1)
            else
                task.wait(3)
            end
        end
    end)
    return true
end

local function stop()
    running = false
    cycleRunning = false
    activeBuyer = nil
    disableNoclip()

    local root = getRoot()
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

