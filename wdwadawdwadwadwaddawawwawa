local function normalizePromptText(value)
    value = tostring(value or ""):lower()
    value = value:gsub("[%p_]+", " ")
    value = value:gsub("%s+", " ")
    return value:match("^%s*(.-)%s*$") or ""
end

local function promptMatches(prompt, wanted)
    if not prompt or not prompt:IsA("ProximityPrompt") then
        return false
    end

    local actual = normalizePromptText(prompt.ActionText)
    local target = normalizePromptText(wanted)

    if actual == target then
        return true
    end

    -- Some versions of the game slightly change capitalization/punctuation/text.
    return actual:find(target, 1, true) ~= nil or target:find(actual, 1, true) ~= nil
end

